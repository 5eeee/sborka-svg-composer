{
  "name": "svg-assembly-test",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:plugin": "node build-plugin.mjs && esbuild plugin/code.ts --outfile=plugin/code.js --target=es2017",
    "format": "prettier --write app.js core.mjs src index.html build-plugin.mjs design-generator.ts tests"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10"
  }
}